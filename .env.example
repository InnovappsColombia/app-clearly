# ==============================================================================
# CLEARLY — Environment Configuration (.env.example)
# Local-First Civic Accessibility & Community Ecosystem
# ==============================================================================

# --- GENERAL APP SETTINGS ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="CLEARLY"
APP_URL="http://localhost:3000"
API_URL="http://localhost:8000"
SECRET_KEY=change_this_to_a_super_secure_random_64_char_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- SOBERANA DATABASE (PostgreSQL 16 + pgvector) ---
POSTGRES_DB=clearly_db
POSTGRES_USER=clearly_admin
POSTGRES_PASSWORD=clearly_secure_pass_2026!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://clearly_admin:clearly_secure_pass_2026!@localhost:5432/clearly_db

# --- MESSAGE BROKER & CACHE (Redis 7) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- S3-COMPATIBLE OBJECT STORAGE (MinIO) ---
MINIO_ROOT_USER=clearly_minio_admin
MINIO_ROOT_PASSWORD=clearly_minio_secret_key_2026!
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=False
MINIO_DOCUMENTS_BUCKET=clearly-documents
MINIO_AUDIO_BUCKET=clearly-audio

# --- LOCAL AI INFERENCE SERVICES (Open Source GPU / CPU Stack) ---
# LLM Server (vLLM / Ollama with Llama 3.1 8B / 3.2 3B)
LLM_PROVIDER=vllm # vllm or ollama
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_TRIAGE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# OCR Microservice (PaddleOCR + Surya)
OCR_SERVICE_URL=http://localhost:8001
OCR_DUAL_PASS_ENABLED=True

# Speech-to-Text & Text-to-Speech (faster-whisper + Piper TTS)
AUDIO_SERVICE_URL=http://localhost:8002
WHISPER_MODEL_SIZE=medium
PIPER_DEFAULT_VOICE=es_ES-davefx-medium

# Embedding Model (BGE-M3 for 1024-dim Vector Search)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# --- WHATSAPP GATEWAY (Evolution API v2) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=clearly_evolution_api_key_2026
WHATSAPP_INSTANCE_NAME=clearly_civic_bot
WHATSAPP_WEBHOOK_URL=http://backend-api:8000/api/v1/webhooks/whatsapp

# --- EXTERNAL INTEGRATIONS (Restricted) ---
# Stripe Connect (Escrow for CLEARLY Premium)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# LiveKit (WebRTC for Premium Virtual Accompaniment)
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

